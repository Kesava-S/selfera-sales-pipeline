# ==============================================================================
# Selfera Sales Pipeline & Dashboard - Environment Configuration
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.local` for local Next.js development:
#      cp .env.example .env.local
# 2. Fill in the values from your Supabase Project Settings (API tab).
# 3. For production (e.g. Vercel), set these in Project Settings -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEXT.JS APPLICATION (Client & Server Components)
# ------------------------------------------------------------------------------
# Your Supabase Project REST URL (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Project Public Anonymous Key (safe for browser exposure with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Dedicated Supabase Schema (Defaults to 'sales-pipe' if not specified)
NEXT_PUBLIC_SUPABASE_SCHEMA=sales-pipe

# ------------------------------------------------------------------------------
# 2. n8n WORKFLOW AUTOMATION (For n8n Instance ONLY - DO NOT EXPOSE TO NEXT.JS)
# ------------------------------------------------------------------------------
# These variables should be configured inside your n8n workflow / environment:
#
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
#
# CRITICAL SECURITY WARNING:
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to Next.js or prefix it with NEXT_PUBLIC_.
# The service role key bypasses PostgreSQL Row Level Security (RLS) and is meant
# strictly for server-side trusted automation engines like n8n.
