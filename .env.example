# ==============================================================================
# Selfera Sales Pipeline & Dashboard - Master Environment Configuration
# ==============================================================================
#
# Environment files supported:
#   - .env.local         -> Local workstation overrides (ignored in git)
#   - .env.development   -> Development environment (loaded on npm run dev)
#   - .env.staging       -> Staging environment (dual-writes to Production)
#   - .env.production    -> Production environment (dual-writes to Staging)
#   - .env.example       -> Template and documentation (tracked in git)
#
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Environment indicator: 'local' | 'development' | 'staging' | 'production'
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# 2. PRIMARY SUPABASE DATABASE
# ------------------------------------------------------------------------------
# REST API URL for the primary Supabase instance
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous key (safe for browser exposure with RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Database schema for the sales pipeline (default: 'sales-pipe')
NEXT_PUBLIC_SUPABASE_SCHEMA=sales-pipe

# Database direct connection password
DATABASE_PASSWORD=your-database-password

# Supabase Service Role Key (Server-side ONLY - bypasses RLS for trusted actions)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 3. DUAL-WRITE REPLICATION (Production -> Staging ONLY)
# ------------------------------------------------------------------------------
# Dual-write is active ONLY in Production (.env.production).
# When mutations occur in Production, they automatically replicate to Staging.
# These keys are NOT needed in .env.development, .env.staging, or .env.local.
DUAL_WRITE_ENABLED=true
DUAL_WRITE_SUPABASE_URL=https://staging-project-ref.supabase.co
DUAL_WRITE_SUPABASE_SERVICE_ROLE_KEY=staging-service-role-key-here
DUAL_WRITE_SUPABASE_SCHEMA=sales-pipe

# ------------------------------------------------------------------------------
# 4. SMTP OUTBOUND EMAIL SERVICE
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@selfera.co.uk
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=Selfera Support

# ------------------------------------------------------------------------------
# 5. IMAP INBOUND EMAIL SYNC
# ------------------------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=support@selfera.co.uk
IMAP_PASS=your-app-password

# ------------------------------------------------------------------------------
# 6. MESSAGING & CHANNELS
# ------------------------------------------------------------------------------
SEND_API_PLATFORMS=Email,WhatsApp

# ------------------------------------------------------------------------------
# 7. WHATSAPP CLOUD API (Meta Business Platform)
# ------------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_DEFAULT_TEMPLATE_NAME=selfera_sales_pipeline_general
WHATSAPP_DEFAULT_TEMPLATE_LANG=en

# ------------------------------------------------------------------------------
# 8. n8n WORKFLOW AUTOMATION (Optional)
# ------------------------------------------------------------------------------
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/send-message
N8N_WEBHOOK_SECRET=your-secret-token
META_HUMAN_AGENT=false
