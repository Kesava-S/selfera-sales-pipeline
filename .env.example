NEXT_PUBLIC_APP_ENV=development

# Primary Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_SCHEMA=sales-pipe
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Dual-Write Replication
DUAL_WRITE_ENABLED=true
DUAL_WRITE_SUPABASE_URL=https://staging-project-ref.supabase.co
DUAL_WRITE_SUPABASE_SERVICE_ROLE_KEY=staging-service-role-key-here
DUAL_WRITE_SUPABASE_SCHEMA=sales-pipe

# SMTP Mail Server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=support@selfera.co.uk
SMTP_PASS=your-app-password
EMAIL_FROM_NAME=Selfera Support

# IMAP Inbound Mail Sync
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=support@selfera.co.uk
IMAP_PASS=your-app-password

# Outbound Platforms
SEND_API_PLATFORMS=Email,WhatsApp

# WhatsApp Cloud API
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_DEFAULT_TEMPLATE_NAME=selfera_sales_pipeline_general
WHATSAPP_DEFAULT_TEMPLATE_LANG=en

# n8n Webhook Integration
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/send-message
N8N_WEBHOOK_SECRET=your-secret-token
META_HUMAN_AGENT=false

# OIDC Authentication
OIDC_ISSUER_URL=http://localhost:3001
OIDC_CLIENT_ID=selfera-sales-dev
OIDC_CLIENT_SECRET=selfera-sales-dev-secret-2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Lead Lookup (beta): Google Places + Companies House
# Google Cloud key with "Places API (New)" enabled (billed per search)
GOOGLE_PLACES_API_KEY=
# Free key: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=

# Meta app secret (App settings > Basic). Lets the webhook check requests really come from Meta.
WHATSAPP_APP_SECRET=

# Email via Resend (delivery, open, click and bounce tracking). Without it, email goes through SMTP above.
RESEND_API_KEY=
# A From address on a domain verified in Resend, e.g. sales@selfera.co.uk
RESEND_FROM_EMAIL=
# Signing secret of the Resend webhook pointing at /api/email/webhook (starts with whsec_)
RESEND_WEBHOOK_SECRET=
# Where replies go (the mailbox the IMAP sync reads). Defaults to SMTP_USER.
EMAIL_REPLY_TO=

# Unsubscribe links in emails. The secret signs each lead's link (falls back to
# SUPABASE_SERVICE_ROLE_KEY); changing it breaks links in emails already sent.
UNSUBSCRIBE_SECRET=
# Public address of this app, used in those links (e.g. https://selfera-sales-dev.vercel.app)
NEXT_PUBLIC_SITE_URL=
